templates/*.template.html

# Secrets — never commit
.env
.env.*
!.env.example

# Repo-owned interpreter. Created locally by `python3 -m venv .venv` so a Hermes update cannot
# take the deploy's dependencies away with it. 232 MB, never committed.
.venv/

# Generated visuals (charts, hero cards) — rebuilt on demand, not source
visuals/

# Generated digest output
output/
assets/fx.json

# Transient deploy lock (see deploy.sh). Never commit it.
.deploy.lock/
